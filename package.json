{
  "name": "photoshop-ai-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI interface for driving Adobe Photoshop through MCP and a UXP plugin.",
  "engines": {
    "node": ">=20.11"
  },
  "workspaces": [
    "shared",
    "paint-engine",
    "mcp-server",
    "orchestrator",
    "studio"
  ],
  "scripts": {
    "smoke": "node scripts/smoke.mjs",
    "docs:tools": "node scripts/generate-tool-docs.mjs",
    "pretest": "npm run build:node",
    "build": "tsc -b shared paint-engine mcp-server orchestrator && npm run build --workspace studio",
    "build:node": "tsc -b shared paint-engine mcp-server orchestrator",
    "typecheck": "tsc -b shared paint-engine mcp-server orchestrator",
    "clean": "tsc -b --clean shared paint-engine mcp-server orchestrator && rimraf studio/dist",
    "dev": "concurrently -n shared,mcp,orchestrator,studio -c cyan,magenta,yellow,green \"npm:dev:shared\" \"npm:dev:mcp\" \"npm:dev:orchestrator\" \"npm:dev:studio\"",
    "dev:shared": "tsc -b shared paint-engine --watch --preserveWatchOutput",
    "dev:mcp": "tsx watch --clear-screen=false mcp-server/src/index.ts",
    "dev:orchestrator": "tsx watch --clear-screen=false orchestrator/src/index.ts",
    "dev:studio": "npm run dev --workspace studio",
    "start": "node orchestrator/dist/index.js",
    "start:mcp": "node mcp-server/dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "inspector": "npx -y @modelcontextprotocol/inspector"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.19.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "globals": "^17.12.0",
    "rimraf": "^6.1.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1",
    "vitest": "^5.0.2"
  }
}
