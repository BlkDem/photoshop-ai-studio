# ---------------------------------------------------------------------------
# Photoshop AI Studio — example environment file
#
# Copy to `.env` in the repository root and fill in the blanks.
#   cp .env.example .env
#
# NEVER commit a filled-in `.env`. It is git-ignored.
# API keys are read only by the Node processes (orchestrator / mcp-server).
# They are never sent to the Studio browser bundle.
# ---------------------------------------------------------------------------

APP_ENV=local
LOG_LEVEL=debug

# --- ports -----------------------------------------------------------------
# Web UI (Vite dev server for `studio/`).
STUDIO_PORT=3000
# MCP server: Streamable HTTP endpoint is mounted at http://127.0.0.1:$MCP_PORT/mcp
MCP_PORT=3001
# Photoshop UXP plugin bridge: WebSocket server the plugin dials into.
# The UXP plugin must be pointed at ws://localhost:3002/bridge
# (edit photoshop-plugin/config.json, or type it into the plugin panel).
PLUGIN_PORT=3002
# Orchestrator: REST + event-stream API consumed by the Studio UI.
# Not listed in the original brief — added because Studio needs its own origin.
ORCHESTRATOR_PORT=3003

# --- MCP server ------------------------------------------------------------
# Comma separated list of allowed Host/Origin headers (DNS-rebinding guard).
MCP_ALLOWED_HOSTS=127.0.0.1:3001,localhost:3001
# Workspace root that all Photoshop file operations are confined to.
WORKSPACE_ROOT=./workspace
# Bridge request timeout (ms) — how long we wait for the plugin to answer.
PLUGIN_BRIDGE_TIMEOUT_MS=30000
# Serve the built Studio bundle from the orchestrator (single-process "prod" mode).
SERVE_STATIC=false

# --- Model gateway ---------------------------------------------------------
# Roles: AI_PLANNER (makes plans), AI_VISION (verifies visuals/state),
#        AI_FAST    (short answers, chat replies).
# Provider is one of: openai | anthropic | openai-compatible | mock
#   openai              -> https://api.openai.com/v1
#   openai-compatible   -> set *_BASE_URL (Ollama, LM Studio, vLLM, Groq, OpenRouter…)
#   anthropic           -> https://api.anthropic.com/v1
#   mock                -> deterministic offline stub, no network
AI_PLANNER_PROVIDER=mock
AI_PLANNER_MODEL=gpt-4.1
AI_PLANNER_API_KEY=
AI_PLANNER_BASE_URL=

AI_VISION_PROVIDER=mock
AI_VISION_MODEL=gpt-4.1
AI_VISION_API_KEY=
AI_VISION_BASE_URL=

AI_FAST_PROVIDER=mock
AI_FAST_MODEL=gpt-4.1-mini
AI_FAST_API_KEY=
AI_FAST_BASE_URL=

# --- Orchestrator ----------------------------------------------------------
# Repair loop budget (spec §24).
AI_MAX_REPAIR_ATTEMPTS=2
# Hard ceiling on plan length, protects against runaway planning.
AI_MAX_PLAN_STEPS=24
# Planner temperature. Keep low: plans drive real mutations.
AI_TEMPERATURE=0.1
# Deterministic rule engine (`jev`) accepts a fast-path match only at/above this
# confidence. Raise it to send more traffic to the LLM.
JEV_MIN_CONFIDENCE=0.82
# Optional external JEV runtime. When empty the built-in deterministic engine is
# used; the Orchestrator code path is identical either way.
JEV_RUNTIME_URL=
JEV_RUNTIME_API_KEY=
# Persist run history + structured logs here (JSONL).
ORCHESTRATOR_DATA_DIR=./data

# --- Photoshop plugin ------------------------------------------------------
# Where `save_psd` / `export_*` write when no explicit path is given.
PHOTOSHOP_OUTPUT_DIR=./workspace/out
