{
  "manifestVersion": 5,
  "id": "com.blkdem.photoshop-ai-studio",
  "name": "Photoshop AI Studio",
  "version": "0.1.0",
  "main": "index.html",

  "host": {
    "app": "PS",
    "minVersion": "25.0.0",
    "data": {
      "apiVersion": 2,
      "loadEvent": "startup",
      "enableMenuRecording": false
    }
  },

  "entrypoints": [
    {
      "type": "panel",
      "id": "aiStudioPanel",
      "label": { "default": "AI Studio", "fr": "AI Studio" },
      "minimumSize": { "width": 300, "height": 280 },
      "maximumSize": { "width": 1600, "height": 1600 },
      "preferredDockedSize": { "width": 360, "height": 520 },
      "preferredFloatingSize": { "width": 420, "height": 640 },
      "icons": [
        { "width": 23, "height": 23, "path": "icons/dark.png", "scale": [1, 2], "theme": ["darkest", "dark", "medium"] },
        { "width": 23, "height": 23, "path": "icons/light.png", "scale": [1, 2], "theme": ["lightest", "light"] }
      ]
    },
    {
      "type": "command",
      "id": "aiStudioReconnect",
      "label": { "default": "AI Studio: Reconnect" }
    }
  ],

  "icons": [
    { "width": 48, "height": 48, "path": "icons/plugin_D.png", "scale": [1, 2], "theme": ["darkest", "dark"], "species": ["pluginList"] },
    { "width": 48, "height": 48, "path": "icons/plugin_N.png", "scale": [1, 2], "theme": ["lightest", "light"], "species": ["pluginList"] }
  ],

  "requiredPermissions": {
    "network": {
      "domains": [
        "ws://localhost/",
        "http://localhost/",
        "ws://127.0.0.1/",
        "http://127.0.0.1/"
      ]
    },
    "localFileSystem": "request",
    "clipboard": "readAndWrite"
  },

  "defaultLocale": "en",
  "langs": ["en"]
}
